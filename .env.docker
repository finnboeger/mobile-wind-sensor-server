# Wind Dashboard - Docker Environment Variables

# ============================================================================
# PocketBase Configuration
# ============================================================================

# PocketBase URL (internal docker network)
POCKETBASE_URL=http://pocketbase:8090

# PocketBase admin credentials (for Dashboard Server to bootstrap)
POCKETBASE_ADMIN_EMAIL=admin@windbot.local
POCKETBASE_ADMIN_PASSWORD=changeme123!

# Admin authentication token generated by PocketBase
# (This is used by services to write to the database)
POCKETBASE_ADMIN_TOKEN=

# PocketBase port (exposed to host)
POCKETBASE_PORT=8090

# Optional: PocketBase encryption key (leave empty for default)
POCKETBASE_ENCRYPTION_KEY=

# ============================================================================
# Dashboard Server Configuration
# ============================================================================

# Dashboard Server port (exposed to host)
DASHBOARD_PORT=3000

# UI default settings
DEFAULT_TIMEFRAME_MINUTES=15
DIRECTION_AVERAGE_MODE=weighted
DEFAULT_SMOOTHING_WINDOW_MINUTES=5

# ============================================================================
# MQTT Ingestion Service Configuration (Docker only)
# ============================================================================

# Run the stack's own Mosquitto broker by adding its compose profile (see
# "Self-hosted MQTT broker" in README.md). Combine profiles with commas, e.g.
# COMPOSE_PROFILES=mosquitto,sap
# COMPOSE_PROFILES=mosquitto

# MQTT broker connection. With the mosquitto profile, empty values default to
# the stack's broker (host mosquitto, port 1883, no TLS, user ingestion);
# without it, MQTT_HOST is required and TLS is on.
MQTT_HOST=
MQTT_PORT=
MQTT_USER=
MQTT_PASSWORD=
MQTT_USE_TLS=

# MQTT topic to source_id mapping
# Format: topic1=source_id1,topic2=source_id2
# Example: wind/sensor1=sensor_1,wind/sensor2=sensor_2
MQTT_TOPICS=wind/sensor1=sensor_1,wind/sensor2=sensor_2

# Traefik in front of the stack's mosquitto broker (docker-compose.traefik.yml)
# Public DNS name of the broker
MQTT_DOMAIN=mqtt.example.com
# Docker network Traefik is attached to
TRAEFIK_NETWORK=traefik
# Traefik entrypoint for MQTT over TLS (e.g. :8883)
TRAEFIK_MQTT_ENTRYPOINT=mqtts
# Traefik certificate resolver
TRAEFIK_CERTRESOLVER=letsencrypt

# ============================================================================
# SAP Sailing Uplink (optional, see sap-uplink/README.md)
# ============================================================================

# Enable the service by adding its compose profile (comma separated with
# others, e.g. COMPOSE_PROFILES=mosquitto,sap)
# COMPOSE_PROFILES=sap

# Server, token, event and course area can also be set in PocketBase's
# sap_settings record, which wins over these.
# Event server, without the /sailingserver path
SAP_URL=
# Access token of a user with TRACKED_RACE:UPDATE permission (see sap-uplink/README.md)
SAP_BEARER_TOKEN=

# Every source is uploaded under its source_id. Sources to leave out, comma-separated
# (e.g. sensors on a test bench)
SAP_EXCLUDE_SOURCES=

# Which races get the wind, set one of:
# a) the current races of an event (id from the event page URL), optionally
#    only on one course area
SAP_EVENT_ID=
SAP_COURSE_AREA=
# b) a fixed list (JSON, single-quoted), named as in the AdminConsole's
#    "Tracked races" table, e.g.
# SAP_RACES='[{"regattaName":"Windbot Test","raceName":"Windbot Test R1 Default"}]'
SAP_RACES=
# c) every tracked race the login may update (careful with admin logins)
SAP_ALL_RACES=false

# ISO time to start from on the first run (default: now)
SAP_START_FROM=

# Forward new measurements as soon as PocketBase announces them (realtime),
# with polling as fallback every SAP_POLL_SECONDS (default 30, or 5 without realtime)
SAP_REALTIME=true
SAP_POLL_SECONDS=

# SAP forwarding health page (sap-dashboard, same compose profile)
SAP_DASHBOARD_PORT=3001
# Path prefix when a proxy routes e.g. /sap to it without stripping the prefix
SAP_DASHBOARD_BASE_PATH=

# ============================================================================
# Logging & Timezone
# ============================================================================

LOG_LEVEL=info
TZ=UTC

# ============================================================================
# Notes
# ============================================================================
#
# 1. POCKETBASE_ADMIN_TOKEN:
#    After PocketBase starts, generate an auth token:
#    1. Visit http://localhost:8090/_/ (admin console)
#    2. Create an application or get admin token
#    3. Paste token value in this file
#    4. Restart docker-compose
#
# 2. MQTT_TOPICS format:
#    - Use comma-separated topic=source pairs
#    - Topics support wildcards: wind/# (catch all), wind/+/speed (+= single level)
#    - source_id values must be unique and match measurement schema
#
# 3. DIRECTION_AVERAGE_MODE options:
#    - "weighted": weighted vector mean (default, recommended)
#    - "arithmetic": simple arithmetic mean
#
# 4. LOG_LEVEL options:
#    - debug: verbose logging
#    - info: normal operation (default)
#    - warn: warnings and errors only
#    - error: errors only
