{
  "name": "wind-dashboard",
  "version": "0.1.0",
  "description": "Wind Dashboard - Vue 3 frontend + Node.js/PocketBase backend",
  "private": true,
  "type": "commonjs",
  "main": "dist/src/backend/index.js",
  "scripts": {
    "install": "npm install",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "./scripts/run-local.sh",
    "dev:frontend": "vite --host",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "tsc --noEmit",
    "typecheck:frontend": "vue-tsc --noEmit -p tsconfig.frontend.json",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "vue-tsc --noEmit -p tsconfig.frontend.json && vite build",
    "start": "node dist/src/backend/index.js",
    "preview": "npm run build && node dist/src/backend/index.js"
  },
  "dependencies": {
    "express": "^5.2.0",
    "pocketbase": "^0.26.8",
    "vue": "^3.5.0",
    "echarts": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "ts-node": "^10.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "vite": "^8.0.8",
    "@vitejs/plugin-vue": "^6.0.6",
    "vue-tsc": "^3.2.6"
  }
}
